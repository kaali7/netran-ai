# ==============================================================================
# Netran AI — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the 'backend/' directory and populate your keys:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary Cloud LLM Inference Engine (Groq)
# ------------------------------------------------------------------------------
# Primary high-speed reasoning engine for:
#   - Document Ingestion & Resume Parsing (gemini_extractor.py)
#   - Stage 1: Market Intelligence & Rubric Synthesis (research_model)
#   - Stage 2: 15-Question Tree & Behavioral Persona Prompting (question_model)
#   - Stage 4: Technical Answer Evaluation & Executive Synthesis (reports_model)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_EVALUATION_MODEL="openai/gpt-oss-120b"

# ------------------------------------------------------------------------------
# 2. Secondary / Fallback Cloud LLMs (Google Gemini)
# ------------------------------------------------------------------------------
# Used as graceful offline/secondary fallback if Groq is unreachable
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.6-flash"

# Optional multi-key rotation pool for Gemini API (helps distribute rate limits)
# GEMINI_API_KEY1="your_gemini_key_1"
# GEMINI_API_KEY2="your_gemini_key_2"
# GEMINI_API_KEY3="your_gemini_key_3"
# GEMINI_API_KEY4="your_gemini_key_4"
# GEMINI_API_KEY5="your_gemini_key_5"

# ------------------------------------------------------------------------------
# 3. Web Intelligence & Deep Market Research (Tavily)
# ------------------------------------------------------------------------------
# Tavily Search API key for Stage 1 multi-vector parallel web retrieval
TAVILY_API_KEY="your_tavily_api_key_here"

# ------------------------------------------------------------------------------
# 4. FastAPI Gateway, Authentication & Database
# ------------------------------------------------------------------------------
# Secret key used for signing candidate JWT tokens (Change in production!)
JWT_SECRET_KEY="netran_ai_jwt_secret_key_change_in_production_9f8e7d6c5b4a3a21"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite / PostgreSQL Connection URL
DATABASE_URL="sqlite:///data/cache.db"

# Allowed CORS Origins (comma-separated list for Vite frontend development)
API_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5174,http://127.0.0.1:5174,http://localhost:8000,http://127.0.0.1:8000"

# Optional regex for LAN development (allows local IPs like 192.168.x.x)
API_CORS_ORIGIN_REGEX="^https?://(localhost|127\.0\.0\.1|192\.168\.\d+\.\d+|10\.\d+\.\d+\.\d+|172\.(1[6-9]|2\d|3[0-1])\.\d+\.\d+)(:\d+)?$"

# ------------------------------------------------------------------------------
# 5. Stage 3 Live Voice Engine & Local Inference
# ------------------------------------------------------------------------------
# Local Ollama LLM for real-time streaming conversational dialogue
OLLAMA_MODEL="qwen2.5:3b"

# Hardware Audio & Microphone Device Index (None / 0 = System Default)
MIC_DEVICE_INDEX=0

# Speech Synthesis (TTS) & Recognition (STT) models
SPEAKER_VOLUME_BOOST=2.0
WHISPER_MODEL="small"
KOKORO_MODEL="hexgrad/Kokoro-82M"

# Conversational Pacing & VAD Controls
ECHO_GUARD_MS=150
SPEECH_START_DEBOUNCE=2
VAD_BARGE_IN_THRESHOLD=0.65

# ------------------------------------------------------------------------------
# 6. Stage 4 Speech Emotion Recognition & Speaker Verification
# ------------------------------------------------------------------------------
# Local CPU Speech Emotion Recognition (SER) model for delivery scoring
SER_MODEL="superb/wav2vec2-base-superb-er"

# Speaker Verification (ECAPA-TDNN) candidate voice authentication
SV_ENABLED=1
SV_THRESHOLD=0.55
SV_MODEL="speechbrain/spkrec-ecapa-voxceleb"
