# ==============================================================================
# Netran AI — Backend Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the 'backend/' directory and populate your keys:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Foundation Models & External Search APIs
# ------------------------------------------------------------------------------
# Gemini API Key for Stage 1, Stage 2, and Stage 4 pipeline synthesis
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.6-flash"

# Tavily Search API Key for Stage 1 deep web market intelligence
TAVILY_API_KEY="your_tavily_api_key_here"

# ------------------------------------------------------------------------------
# 2. FastAPI Gateway, Authentication & Database
# ------------------------------------------------------------------------------
# Secret key used for signing candidate JWT tokens (Change in production!)
JWT_SECRET_KEY="netran_ai_jwt_secret_key_change_in_production_9f8e7d6c5b4a3a21"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite / PostgreSQL Connection URL
DATABASE_URL="sqlite:///data/cache.db"

# Allowed CORS Origins (comma-separated)
API_CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5174,http://127.0.0.1:5174"

# ------------------------------------------------------------------------------
# 3. Stage 3 Live Voice Engine & Local Inference (Optional / Defaults)
# ------------------------------------------------------------------------------
# Local Ollama LLM for desktop conversational loop (defaults to qwen2.5:3b)
OLLAMA_MODEL="qwen2.5:3b"

# Hardware Audio & Microphone Device Index (None = System Default)
MIC_DEVICE_INDEX=0

# Kokoro TTS volume multiplier & Faster-Whisper model size
SPEAKER_VOLUME_BOOST=2.0
WHISPER_MODEL="small"
KOKORO_MODEL="hexgrad/Kokoro-82M"

# TurnManager & VAD Conversation Control
ECHO_GUARD_MS=150
SPEECH_START_DEBOUNCE=2
VAD_BARGE_IN_THRESHOLD=0.65

# ------------------------------------------------------------------------------
# 4. Speaker Verification (ECAPA-TDNN)
# ------------------------------------------------------------------------------
SV_ENABLED=1
SV_THRESHOLD=0.55
SV_MODEL="speechbrain/spkrec-ecapa-voxceleb"
